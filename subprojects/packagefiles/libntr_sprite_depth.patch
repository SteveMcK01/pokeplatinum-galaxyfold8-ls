+// Also asked for every frame: main-engine OBJ layers (bit n: priority n) repeated across the
+// sides of a wide scene, the 4:3 picture wrapping around (left of the middle shows its right
+// edge, and so on), for 2D effects with no edges of their own (rain, snow, sand). Default:
+// none (OBJs stay in the 4:3 middle).
+void SIM_SetWidescreenObjWrap(u8 objPriorities);
+// Also asked for every frame: main-engine text-mode BG layers (bit n: BGn) drawn in the 4:3 middle as
+// usual, with their leftmost and rightmost pixel columns continued across the sides of a wide scene,
+// for a bar or a box that reaches the screen's edges (its text stays in the middle). Default: none.
+void SIM_SetWidescreenBgEdgeExtend(u8 bgLayers);
+// Also asked for every frame: main- or sub-engine text-mode BG layers (bit n: BGn) whose sides, in a wide scene, repeat the
+// picture's pixel column `column` (0 to 1 across the 256 pixels) for each row, on both sides, instead of the edge columns:
+// for a background of horizontal stripes whose own edges are a frame. Wins over the edge extension and the mirror.
+void SIM_SetWidescreenBgStripe(u8 bgLayers, float column);
+// Wide BG layers (SIM_SetWidescreenSceneOptions) whose sides mirror the 256-pixel picture instead of repeating it
+void SIM_SetWidescreenBgMirror(u8 bgLayers);
+// Polygons drawn while it is non-zero are moved toward the camera for the depth test only: nothing at their lowest point
+// on screen, `top` (fx32, view units) at their highest. For the overworld's sprites. Default: 0
+void SIM_SetSpriteDepthBias(fx32 top);
+// 0 = none, 1 = clip bottom 35% (submerged sprite), 2 = clip top 35% (upside-down reflection)
+void SIM_SetSpriteSubmergeClip(int mode);
+// Layers (SIM_SetWidescreenBgEdgeExtend) whose sides mirror the 256-pixel picture instead of continuing its edge columns
+void SIM_SetWidescreenBgEdgeMirror(u8 bgLayers);
+
+// Small images stamped onto a wide BG layer's picture each frame (Platinum's HP boxes get caps at their outer ends,
+// in the sides of the wide screen). The image is RGB, pure white is transparent. A stamp is placed with its top left
+// at (x, y) in the 256-pixel screen's coordinates (x may be negative or past 255), drawn height rows tall (the
+// row above the image's last five is repeated to stretch it), mirrored left to right when flipX
+typedef struct SIM_WideStamp {
+  short x;
+  short y;
+  short height;
+  unsigned char flipX;
+  unsigned char extraTop; // of a stretch, the rows added under the image's top (the rest go under its HP band)
+} SIM_WideStamp;
+void SIM_SetWidescreenStampImage(const unsigned char *rgb, int width, int height);
+void SIM_SetWidescreenStamps(unsigned char bgLayer, const SIM_WideStamp *stamps, int count);
+// Also asked for every frame: main-engine OBJ priorities (bit n: priority n) whose dark pixels at the 4:3 picture's
+// leftmost and rightmost columns continue across the sides of a wide scene, for a black bar that reaches the
+// screen's edge (the Gen 5 battle's party balls' bar and ability bar). Default: none.
+void SIM_SetWidescreenObjEdgeExtend(u8 objPriorities);
 BOOL SIM_IsWidescreenActive(void);
+
+// The DS's polygon ID rule for translucent polygons: one is not blended over a pixel that another translucent
