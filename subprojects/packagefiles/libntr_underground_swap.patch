 #include "screenquads.h"
 
+extern "C" BOOL __attribute__((weak)) SIM_Prj_AutoSwapScreens(void) {
+  return FALSE;
+}
+
+extern "C" BOOL __attribute__((weak)) TouchControls_GetMainDsTouch(
+    int winW, int winH, int viewX, int viewY, int viewW, int viewH,
+    int mouseX, int mouseY, BOOL mouseDown, int *outX, int *outY) {
+  (void)winW;
+  (void)winH;
+  if (!mouseDown || !outX || !outY || viewW <= 0 || viewH <= 0) {
+    return FALSE;
+  }
+  if (mouseX >= viewX && mouseX < viewX + viewW && mouseY >= viewY &&
+      mouseY < viewY + viewH) {
+    *outX = (int)(((long long)(mouseX - viewX) * SIM_NDS_SCREEN_WIDTH) / viewW);
+    *outY = (int)(((long long)(mouseY - viewY) * SIM_NDS_SCREEN_HEIGHT) / viewH);
+    return TRUE;
+  }
+  return FALSE;
+}
+
+static bool s_EffectiveSwapScreens = false;
+
